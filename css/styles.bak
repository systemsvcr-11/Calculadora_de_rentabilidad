:root {
  --bg: #f4f6f7;
  --panel: #ffffff;
  --line: #e1e7e9;
  --text: #1a252a;
  --muted: #718087;
  --primary: #273238;
  --primary-2: #34434a;
  --green: #17734b;
  --green-bg: #e8f6ee;
  --yellow: #956700;
  --yellow-bg: #fff6dc;
  --red: #a33131;
  --red-bg: #ffebeb;
  --shadow: 0 8px 28px rgba(35, 52, 59, .06);
  --radius: 14px;
}
* { box-sizing: border-box; }
body { margin:0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background:var(--bg); color:var(--text); }
button,input,select { font:inherit; }
button { cursor:pointer; }
button:disabled { opacity:.65; cursor:wait; }
.app { min-height:100vh; display:flex; }
.sidebar { width:250px; height:100vh; position:sticky; top:0; display:flex; flex-direction:column; padding:18px; background:#fff; border-right:1px solid var(--line); }
.brand { display:flex; gap:11px; align-items:center; padding:4px 4px 22px; }
.brand-mark { width:42px; height:42px; display:grid; place-items:center; border-radius:12px; background:#edf1f2; font-size:22px; }
.brand-name { font-weight:800; font-size:15px; }
.brand-subtitle { margin-top:2px; font-size:12px; color:var(--muted); }
.nav { display:flex; flex-direction:column; gap:4px; }
.nav-btn { width:100%; padding:11px 12px; text-align:left; border:0; border-radius:10px; background:transparent; color:#5b6a72; }
.nav-btn:hover { background:#f1f4f5; }
.nav-btn.active { background:var(--primary); color:#fff; }
.sidebar-note { margin-top:auto; padding:10px 4px 2px; text-align:center; color:#94a0a5; font-size:10px; }
.main { flex:1; min-width:0; padding:24px; }
.topbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; gap:15px; }
.topbar h1 { margin:0; font-size:28px; }
.topbar p { margin:4px 0 0; color:var(--muted); }
.view { display:none; }
.view.active { display:block; }
.cards { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:16px; }
.card { background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); padding:18px; }
.card-label { color:var(--muted); font-size:12px; }
.card-value { margin-top:7px; font-size:26px; font-weight:850; }
.card-extra { margin-top:5px; color:var(--muted); font-size:12px; }
.grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px; }
.panel { background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); padding:18px; min-width:0; margin-bottom:16px; }
.panel-head { display:flex; justify-content:space-between; gap:15px; align-items:flex-start; margin-bottom:14px; }
.panel-head h2 { margin:0; font-size:17px; }
.panel-head p { margin:5px 0 0; font-size:12px; color:var(--muted); }
.btn { border:0; border-radius:9px; padding:10px 14px; }
.btn-primary { background:var(--primary); color:#fff; }
.btn-primary:hover { background:var(--primary-2); }
.btn-secondary { background:#edf1f2; color:var(--primary); }
.btn-secondary:hover { background:#e3e9eb; }
.form-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; }
label { display:block; color:#526169; font-size:12px; }
label input,label select { display:block; width:100%; margin-top:6px; padding:10px; border:1px solid #d5dfe2; border-radius:9px; background:#fff; color:var(--text); outline:none; }
label input:focus,label select:focus { border-color:#9aa8ae; }
.search { width:190px; padding:9px 10px; border:1px solid var(--line); border-radius:9px; }
.section-row { display:flex; justify-content:space-between; align-items:center; gap:10px; margin:18px 0 10px; }
.section-row h3 { margin:0; font-size:14px; }
.recipe-rows { min-height:16px; }
.recipe-row { display:grid; grid-template-columns:1.55fr .72fr .62fr 40px; gap:8px; align-items:center; margin-bottom:8px; }
.recipe-row input,.recipe-row select { width:100%; padding:9px; border:1px solid #d5dfe2; border-radius:8px; background:#fff; }
.recipe-row input[readonly] { background:#f6f8f9; color:#56666e; }
.icon-btn { height:38px; border:0; border-radius:8px; background:#ffeded; color:#9c3131; font-size:19px; }
.form-actions { display:flex; flex-wrap:wrap; gap:9px; margin-top:15px; }
.hint { margin:12px 0; padding:11px; background:#f4f7f8; border-radius:10px; color:#607077; font-size:12px; }
.mini-preview { min-height:22px; padding:8px 0 0; font-size:12px; color:#53636a; }
.table-wrap { overflow:auto; }
.table { width:100%; border-collapse:collapse; font-size:12px; }
.table th,.table td { padding:10px 8px; text-align:left; border-bottom:1px solid #edf1f2; white-space:nowrap; vertical-align:top; }
.table th { color:#76848b; font-weight:700; }
.status { display:inline-flex; padding:5px 8px; border-radius:999px; font-size:11px; font-weight:800; }
.status.green { background:var(--green-bg); color:var(--green); }
.status.yellow { background:var(--yellow-bg); color:var(--yellow); }
.status.red { background:var(--red-bg); color:var(--red); }
.text-green { color:var(--green); font-weight:800; }
.text-red { color:var(--red); font-weight:800; }
.small-muted { margin-top:5px; color:#8a979c; font-size:10px; }
.action-link { border:0; padding:0; margin:0 8px 5px 0; background:none; color:#3d6572; font-weight:750; }
.empty { padding:22px; text-align:center; color:var(--muted); background:#f8fafb; border-radius:10px; }
.impact-controls { display:grid; grid-template-columns:1fr 220px auto; gap:10px; align-items:end; margin-bottom:12px; }
.sim-top { display:grid; grid-template-columns:1fr 220px; gap:12px; margin-bottom:16px; }
.simulation-layout { display:grid; grid-template-columns:1.4fr .6fr; gap:16px; }
.sim-summary { padding:16px; background:#f8fafb; border:1px solid var(--line); border-radius:12px; align-self:start; }
.sim-summary h3 { margin:0 0 9px; }
.metric { display:flex; justify-content:space-between; gap:10px; padding:9px 0; border-bottom:1px solid #e4eaec; font-size:13px; }
.metric strong { font-size:16px; }
.recommend { margin-top:14px; padding:14px; border-radius:10px; background:#eef5ff; }
.recommend span { color:#5b6d76; font-size:12px; }
.recommend strong { display:block; margin-top:4px; font-size:25px; }
.recommend small { color:#718087; }
.summary-status { margin-top:12px; }
.toast { position:fixed; right:20px; bottom:20px; z-index:1000; background:var(--primary); color:#fff; padding:12px 15px; border-radius:10px; opacity:0; transform:translateY(8px); pointer-events:none; transition:.2s; }
.toast.show { opacity:1; transform:translateY(0); }
@media (max-width:1000px) {
  .sidebar { width:215px; }
  .cards { grid-template-columns:repeat(2,1fr); }
  .grid-2,.simulation-layout { grid-template-columns:1fr; }
}
@media (max-width:700px) {
  .app { display:block; }
  .sidebar { width:100%; height:auto; position:sticky; z-index:10; border-right:0; border-bottom:1px solid var(--line); padding:10px; }
  .brand { padding:2px 4px 10px; }
  .nav { flex-direction:row; overflow:auto; gap:5px; }
  .nav-btn { width:auto; white-space:nowrap; padding:9px 11px; }
  .sidebar-note { display:none; }
  .main { padding:14px; }
  .topbar h1 { font-size:23px; }
  .cards { grid-template-columns:1fr 1fr; }
  .form-grid,.impact-controls,.sim-top { grid-template-columns:1fr; }
  .search { width:100%; }
  .panel { padding:14px; }
  .recipe-row { grid-template-columns:1.2fr .7fr .7fr 40px; }
}
